<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#090708"><title>MÆD — The Rock Vernissage</title>
<style>
*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;overscroll-behavior:none}body{background:#080708;color:#fff0e4;font-family:Georgia,'Times New Roman',serif}button{cursor:pointer;touch-action:manipulation;color:#fff0e4;background:#4c211f;border:1px solid #bb7770;border-radius:2px;font:600 clamp(10px,1.45vh,12px) Arial,sans-serif;letter-spacing:.1em;padding:clamp(10px,1.6vh,14px) 14px;min-height:39px}button:focus-visible{outline:2px solid white;outline-offset:3px}button:hover{background:#77312c}main{height:100vh;height:100dvh;width:100%;position:relative;overflow:hidden;isolation:isolate}.mast{position:absolute;z-index:10;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:calc(12px + env(safe-area-inset-top)) clamp(14px,4vw,32px);font:10px Arial,sans-serif;letter-spacing:.13em;text-shadow:0 2px 12px #000;pointer-events:none}.mast strong{font-size:clamp(20px,3vw,28px);letter-spacing:.13em}.mast span{text-align:right;font-size:clamp(8px,1.3vw,11px)}.scene{position:absolute;inset:0;display:none;overflow:hidden}.scene.active{display:flex;flex-direction:column;align-items:center;justify-content:center;animation:fade .6s ease both}@keyframes fade{from{opacity:0}to{opacity:1}}.eyebrow{font:600 clamp(9px,1.5vh,12px) Arial,sans-serif;letter-spacing:.23em;color:#f1a49a}h1{font-size:clamp(27px,5.5vh,55px);line-height:1.08;margin:8px 0;text-wrap:balance}p{font-size:clamp(12px,1.9vh,17px);line-height:1.35;margin:6px auto;max-width:550px}#intro{padding:calc(58px + env(safe-area-inset-top)) 18px calc(32px + env(safe-area-inset-bottom));text-align:center}#intro .photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;z-index:-2}#intro:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0008,#0005 40%,#000b);z-index:-1}#intro .introcopy{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(8px,2vh,18px);width:100%;max-width:650px;text-shadow:0 3px 14px #000}#intro h1{font-size:clamp(33px,6.2vh,64px)}#intro p{max-width:470px;color:#fff1e8}#intro button{margin-top:10px;padding:14px 24px;background:#672d29e8}#exhibit{padding:calc(49px + env(safe-area-inset-top)) 12px calc(18px + env(safe-area-inset-bottom));gap:clamp(5px,.9vh,11px);text-align:center}#exhibit h1{font-size:clamp(20px,3.5vh,34px);margin:0}.artframe{position:relative;flex:1 1 auto;min-height:60px;max-height:min(48dvh,530px);width:auto;max-width:88vw;aspect-ratio:1;border:clamp(3px,.7vh,7px) solid #2c211d;outline:1px solid #a4866a;overflow:hidden;background:#1c1115;box-shadow:0 10px 40px #0008}.artframe img,.artframe video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}.artframe img{animation:zoom 35s ease-in-out infinite alternate}.artframe video{opacity:1;transition:opacity 1.35s ease;pointer-events:none}.artframe:after{content:"";position:absolute;inset:0;background:radial-gradient(circle,transparent 54%,#16080a55);pointer-events:none}@keyframes zoom{to{transform:scale(1.13)}}.progress{font:10px Arial,sans-serif;letter-spacing:.18em;color:#d9a69c}.question{min-height:clamp(38px,6vh,58px);display:flex;align-items:center;justify-content:center;max-width:620px;padding:0 5px;font-size:clamp(12px,1.8vh,17px);line-height:1.28}.choices{width:min(92vw,540px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.choices button{margin:0;padding:8px 7px;min-height:40px;font-size:clamp(9px,1.4vh,12px);letter-spacing:.02em}.spotify{width:min(92vw,540px);flex:none}.spotify iframe{width:100%;height:80px;border:0;border-radius:9px;display:block}.spotify-link{display:inline-block;margin:4px auto 0;padding:7px 14px;border:1px solid #bb7770;border-radius:3px;color:#fff0e4;background:#4c211f;text-decoration:none;font:600 11px Arial,sans-serif;letter-spacing:.05em}.spotify-link:focus-visible{outline:2px solid #fff}.notice{font:10px Arial,sans-serif;color:#c8aaa1;margin:3px 0 0}.endactions{display:none;gap:8px;justify-content:center;flex-wrap:wrap}.endactions.visible{display:flex}.endactions button{font-size:10px}.foot{position:absolute;bottom:0;left:0;right:0;z-index:8;text-align:center;font:8px Arial,sans-serif;letter-spacing:.07em;color:#b7a099;padding:4px;background:#08070888;pointer-events:none}@media(max-height:690px){#exhibit{gap:4px;padding-top:43px;padding-bottom:15px}.artframe{max-height:36dvh}.question{min-height:33px}.notice{display:none}.choices button{min-height:34px;padding:6px}.spotify iframe{height:80px}}@media(max-height:530px){#exhibit .eyebrow{display:none}.artframe{max-height:25dvh}.question{font-size:12px;min-height:28px}#exhibit h1{font-size:20px}.mast{padding-top:8px}.foot{display:none}}@media(orientation:landscape) and (max-height:520px){.artframe{max-height:27dvh}#exhibit{gap:3px}}@media(prefers-reduced-motion:reduce){.artframe img,.scene{animation:none}.artframe video{transition:none}}
</style></head><body><main><div class="mast"><strong>MÆD</strong><span>THE GALLERY OF HUMAN DECAY</span></div>
<section class="scene active" id="intro"><img class="photo" src="data:image/jpeg;base64," alt="The masked curator presenting a MÆD artwork"><div class="introcopy"><div class="eyebrow">THE CURATOR INVITES YOU</div><h1>Welcome to the<br>Rock Vernissage</h1><p>“We do not merely exhibit art here. We exhibit humanity. And tonight, you are part of the collection.”</p><button id="enter">ENTER THE GALLERY</button></div></section>
<section class="scene" id="exhibit"><div class="eyebrow">EXHIBIT 01 · GREED</div><h1>When the World Is Not Enough</h1><div class="artframe"><img src="data:image/jpeg;base64," alt="When the World Is Not Enough artwork"><video id="artVideo" muted playsinline loop preload="auto" aria-label="Animated video art gradually fading to reveal the artwork"><source src="data:video/mp4;base64," type="video/mp4"></video></div><div class="progress" id="progress">QUESTION 1 OF 4 · THE VEIL IS INTACT</div><div class="question" id="question" aria-live="polite"></div><div class="choices" id="choices"><button id="answerA"></button><button id="answerB"></button></div><div class="endactions" id="endactions"><button id="restart">BEGIN AGAIN</button><button id="reveal">VIEW THE ARTWORK</button></div><div class="spotify"><iframe title="Listen to MÆD on Spotify" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" src="https://open.spotify.com/embed/track/3cq1SHG8doceAcIZ2CJjVv?utm_source=generator"></iframe><a class="spotify-link" href="https://open.spotify.com/track/3cq1SHG8doceAcIZ2CJjVv" target="_blank" rel="noopener noreferrer">▶ OPEN TRACK IN SPOTIFY</a></div></section><div class="foot">AN INTERACTIVE MÆD EXPERIENCE</div></main>
<script>
const questions=[
{q:'The curator offers you everything you have ever wanted. What do you do?',a:'TAKE IT ALL',b:'ASK WHAT IT COSTS'},
{q:'You discover that your fortune was built on someone else’s loss. What now?',a:'LOOK THE OTHER WAY',b:'MAKE AMENDS'},
{q:'One final treasure remains. Taking it would leave nothing for anyone else.',a:'CLAIM IT',b:'LEAVE IT BEHIND'},
{q:'The curator holds up a mirror. Who is responsible for the world you see?',a:'EVERYONE ELSE',b:'ALL OF US'}
];
let step=0,choices=[];const video=document.getElementById('artVideo');const q=document.getElementById('question');const progress=document.getElementById('progress');const buttons=document.getElementById('choices');const end=document.getElementById('endactions');
function render(){if(step<questions.length){const item=questions[step];q.textContent=item.q;document.getElementById('answerA').textContent=item.a;document.getElementById('answerB').textContent=item.b;progress.textContent=`QUESTION ${step+1} OF ${questions.length} · THE VEIL IS LIFTING`;buttons.style.display='grid';end.classList.remove('visible')}else{video.style.opacity='0';video.pause();progress.textContent='EXHIBIT REVEALED · THE FINAL VERDICT';q.textContent=choices.filter(x=>x===1).length>=3?'“You have begun to see beyond yourself. The work of repair is yours to begin.”':'“You came here to judge humanity. But your choices have become part of the exhibition.”';buttons.style.display='none';end.classList.add('visible')}}
function answer(value){if(step>=questions.length)return;choices.push(value);step++;video.style.opacity=String(Math.max(0,1-step/questions.length));if(step===questions.length){setTimeout(()=>video.pause(),1450)}render()}
document.getElementById('answerA').addEventListener('click',()=>answer(0));document.getElementById('answerB').addEventListener('click',()=>answer(1));document.getElementById('enter').addEventListener('click',()=>{document.getElementById('intro').classList.remove('active');document.getElementById('exhibit').classList.add('active');video.play().catch(()=>{});render()});document.getElementById('restart').addEventListener('click',()=>{step=0;choices=[];video.style.opacity='1';video.currentTime=0;document.getElementById('exhibit').classList.remove('active');document.getElementById('intro').classList.add('active')});document.getElementById('reveal').addEventListener('click',()=>{q.textContent='“The artwork was never hidden from you. Only your perspective was.”'});
render();
</script></body></html>
